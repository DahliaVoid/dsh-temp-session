{
  "name": "dsh-temp-session",
  "version": "0.1.0",
  "description": "Optional workspace selection + workspace-free temporary sessions for DeepSeek Harness Web (dsh).",
  "keywords": [
    "dsh",
    "plugin",
    "deepseek-harness",
    "workspace",
    "temp-session"
  ],
  "homepage": "https://github.com/DahliaVoid/dsh-temp-session#readme",
  "bugs": {
    "url": "https://github.com/DahliaVoid/dsh-temp-session/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DahliaVoid/dsh-temp-session.git"
  },
  "license": "MIT",
  "author": "",
  "type": "module",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "main": "lib/index.js",
  "directories": {
    "lib": "lib"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "dsh": {
    "client": {
      "inject": [
        "sessions",
        "workspaces"
      ],
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
